{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "prebuild": "npm run validate:env",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "doctor": "react-doctor . --verbose --scope full --no-respect-inline-disables --blocking warning --no-color",
    "validate:env": "node scripts/validate-env.mjs",
    "verify:sentry": "node scripts/verify-sentry.mjs",
    "check": "npm-run-all --parallel typecheck lint test doctor"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.3",
