# ---------------------------------------------------------------------------
# Next.js / Vercel
# ---------------------------------------------------------------------------

# Required for portfolio content and contact form functionality.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Required only when running the development-only admin dashboard.
# Public pages and public API routes do not load Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional product analytics. Keep the same-origin proxy for best reliability.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/gbx

# Optional, low-overhead Sentry error monitoring and sampled tracing.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional source-map upload. Set all three values together.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
# Temporarily enable this only on a preview deployment while verifying Sentry.
ENABLE_SENTRY_TEST_PAGE=false

# Shared with the Convex deployment for on-demand cache revalidation.
REVALIDATE_SECRET=replace_with_at_least_32_random_characters

# ---------------------------------------------------------------------------
# Convex dashboard environment variables
# Configure these in the Convex dashboard, not in Vercel.
# ---------------------------------------------------------------------------

CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
ENABLE_ADMIN=false
SENDER_EMAIL=Gerald Bahati <contact@geraldbahati.dev>
RECIPIENT_EMAIL=contact@geraldbahati.dev
SITE_REVALIDATE_URL=https://geraldbahati.dev
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
